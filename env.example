# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Google Gemini (agente IA)
# Conseguir la clave gratis en https://aistudio.google.com/app/apikey
# (no pide tarjeta para el nivel gratuito).
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# WhatsApp Cloud API — línea Civil
# (Meta for Developers -> tu app -> WhatsApp -> API Setup)
# ---------------------------------------------------------------------
WHATSAPP_CIVIL_PHONE_NUMBER_ID=
WHATSAPP_CIVIL_ACCESS_TOKEN=
WHATSAPP_CIVIL_WABA_ID=

# ---------------------------------------------------------------------
# WhatsApp Cloud API — línea Penal
# ---------------------------------------------------------------------
WHATSAPP_PENAL_PHONE_NUMBER_ID=
WHATSAPP_PENAL_ACCESS_TOKEN=
WHATSAPP_PENAL_WABA_ID=

# Token propio que vos elegís y cargás también en el webhook de Meta
# (uno para cada app, o el mismo para las dos si usás una sola app de Meta)
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------
# Instagram / Facebook Messaging (Meta Graph API)
# ---------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

FACEBOOK_CIVIL_PAGE_ID=
FACEBOOK_CIVIL_PAGE_ACCESS_TOKEN=
INSTAGRAM_CIVIL_BUSINESS_ID=

FACEBOOK_PENAL_PAGE_ID=
FACEBOOK_PENAL_PAGE_ACCESS_TOKEN=
INSTAGRAM_PENAL_BUSINESS_ID=

# Nombre de una plantilla aprobada de WhatsApp para continuar por ese canal
# la conversación de alguien que llegó por la landing (opcional).
LANDING_WHATSAPP_TEMPLATE=

# ---------------------------------------------------------------------
# Notificación al administrador
# ---------------------------------------------------------------------
ADMIN_WHATSAPP_PHONE=   # formato E.164 sin '+', ej: 5491122223333

# ---------------------------------------------------------------------
# Campañas — envío automático a bases cargadas por Excel
# ---------------------------------------------------------------------
# Secreto propio (inventá cualquier string largo) que protege el endpoint
# /api/campaigns/tick. Lo tenés que cargar acá Y en la configuración del
# cron externo que lo llama cada 1 minuto (ver docs/SETUP.md).
CRON_SECRET=

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
