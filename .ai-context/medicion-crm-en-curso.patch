+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { armarReferencia, detalleOrigen, detectarPalabraClave, leerReferencia, palabrasClaveDe } from "@/lib/origen-redes";
+import { detectarFuente } from "@/lib/fuente";
+import { detalleFormulario, normalizarLead, origenDelFormulario, utmDelFormulario } from "@/lib/landing-lead";
+import { enlaceWhatsAppOrigen, mensajePrearmado } from "@/lib/redes/ctas";
+
+// Datos ficticios: ningún nombre ni teléfono real.
+
+test("referencia: se lee red, campaña y pieza del final del mensaje", () => {
+  const o = leerReferencia("Hola, vi la guía de ART en su web. (ref: IG-ART-0112)");
+  assert.deepEqual(o, { canal: "redes", red: "instagram", campana: "ART", pieza: "0112", ref: "IG-ART-0112", palabraClave: null, evidencia: "referencia" });
+});
+
+test("referencia: minúsculas, espacios y segmentos que faltan", () => {
+  assert.equal(leerReferencia("hola (Ref:  fb-perfil )")?.campana, "PERFIL");
+  assert.equal(leerReferencia("hola (ref: TT)")?.red, "tiktok");
+  const sinCampana = leerReferencia("(ref: YT-X-R0115)");
+  assert.equal(sinCampana?.campana, null);
+  assert.equal(sinCampana?.pieza, "R0115");
+  assert.equal(leerReferencia("(ref: GO)")?.canal, "landing");
+  assert.equal(leerReferencia("(ref: WEB)")?.red, "web");
+  // Red desconocida: se conserva el código, sin inventar un nombre.
+  assert.equal(leerReferencia("(ref: NEWS-DIC)")?.red, "news");
+});
+
+test("referencia: sin formato válido no hay origen", () => {
+  assert.equal(leerReferencia("Me pasaron la referencia de un amigo"), null);
+  assert.equal(leerReferencia("(ref: )"), null);
+  assert.equal(leerReferencia("(ref: IG-<script>)"), null);
+  assert.equal(leerReferencia("(ref: IG-ESTOESDEMASIADOLARGO)"), null);
+  assert.equal(leerReferencia(null), null);
+});
+
+test("referencia: si hay dos, vale la última (la que agregó la landing)", () => {
+  assert.equal(leerReferencia("(ref: IG-PERFIL-BIO) y después (ref: FB-ART-0112)")?.ref, "FB-ART-0112");
+});
+
+test("armar y leer son inversos", () => {
+  for (const caso of [
+    { red: "ig", campana: "art", pieza: "0112" },
+    { red: "FB", campana: "Black-Friday", pieza: null },
+    { red: "TT", campana: null, pieza: "r01" },
+    { red: "WEB", campana: null, pieza: null },
+  ]) {
+    const ref = armarReferencia(caso)!;
+    const o = leerReferencia(`(ref: ${ref})`)!;
+    assert.equal(o.ref, ref);
+    assert.equal(armarReferencia({ red: ref.split("-")[0], campana: o.campana, pieza: o.pieza }), ref);
+  }
+  assert.equal(armarReferencia({ red: "IG", campana: "Black-Friday" }), "IG-BLACKFRIDAY");
+  assert.equal(armarReferencia({ red: "" }), null);
+});
+
+test("palabra clave: solo cuando el mensaje es la palabra, con saludo o sin él", () => {
+  const p = palabrasClaveDe("civil");
+  assert.equal(detectarPalabraClave("ART", p), "ART");
+  assert.equal(detectarPalabraClave("Hola! art 🙂", p), "ART");
+  assert.equal(detectarPalabraClave("Buenas tardes, quiero info sobre FIRMA", p), "FIRMA");
+  assert.equal(detectarPalabraClave("La ART no me quiere pagar", p), null);
+  assert.equal(detectarPalabraClave("Hola", p), null);
+  assert.equal(detectarPalabraClave("ART", palabrasClaveDe("marketing")), null);
+  assert.equal(detectarPalabraClave(`ART ${"x".repeat(90)}`, p), null);
+});
+
+test("palabras clave configuradas en el perfil se suman a las de la serie", () => {
+  const ids = [{ texto: "aguinaldo", fuente: "palabra_clave" }, { texto: "otra cosa larga", fuente: "landing" }, { texto: "<", fuente: "palabra_clave" }];
+  const p = palabrasClaveDe("coberturas_medicas", ids);
+  assert.ok(p.includes("AGUINALDO") && p.includes("APORTES"));
+  assert.equal(p.length, 4);
+});
+
+test("detectarFuente: la referencia acredita Instagram con el origen completo", () => {
+  const f = detectarFuente({ channelType: "whatsapp", body: "Hola, quiero hacer una consulta. (ref: IG-ART-0112)" });
+  assert.equal(f.fuente, "instagram");
+  assert.equal(f.detalle, "redes · Instagram · campaña ART · pieza 0112 · ref IG-ART-0112");
+  assert.equal(f.origen?.pieza, "0112");
+});
+
+test("detectarFuente: redes que la columna no admite quedan no informadas, con el detalle", () => {
