--- /dev/null
+++ b/src/lib/origen-redes.ts
@@ -0,0 +1,165 @@
+/**
+ * Origen de una consulta que vino de redes o de una landing (20/11, medición
+ * de punta a punta). Puro, sin dependencias: lo usa `detectarFuente`.
+ *
+ * Dos evidencias, y solo esas:
+ *  1. La referencia «(ref: RED-CAMPAÑA-PIEZA)» al final del mensaje. La pone la
+ *     landing (a partir de las etiquetas utm_* de la visita) o el enlace a
+ *     WhatsApp de la bio, de una historia o de un texto. Formato documentado en
+ *     docs/redes/MEDICION-2026-11-20.md:
+ *       - RED: código de 1 a 4 letras (IG, FB, TT, YT, TH, MT, GO, BI, WEB…).
+ *       - CAMPAÑA y PIEZA: letras y números en mayúscula, hasta 12 cada una.
+ *         Las que faltan al final se omiten; una campaña ausente con pieza
+ *         presente se escribe «X».
+ *  2. Una palabra clave de redes («Escribí ART», «Respondé con FIRMA») cuando
+ *     el mensaje es solo esa palabra, con o sin saludo. «La ART no me paga» no
+ *     cuenta: es una consulta, no un llamado de una pieza.
+ *
+ * Nada se supone: sin referencia ni palabra clave, no hay origen de redes.
+ */
+
+export type CanalOrigen = "redes" | "landing";
+
+export interface OrigenRedes {
+  canal: CanalOrigen;
+  /** Red en minúscula (instagram, facebook, tiktok…), o null si no se sabe. */
+  red: string | null;
+  campana: string | null;
+  pieza: string | null;
+  /** Referencia tal como vino, normalizada (IG-ART-0112), o null. */
+  ref: string | null;
+  palabraClave: string | null;
+  evidencia: "referencia" | "palabra_clave";
+}
+
+/** Códigos de red de la referencia. Lo que no está acá se conserva en minúscula. */
+export const REDES_POR_CODIGO: Record<string, { red: string; nombre: string; canal: CanalOrigen }> = {
+  IG: { red: "instagram", nombre: "Instagram", canal: "redes" },
+  FB: { red: "facebook", nombre: "Facebook", canal: "redes" },
+  TT: { red: "tiktok", nombre: "TikTok", canal: "redes" },
+  YT: { red: "youtube", nombre: "YouTube", canal: "redes" },
+  TH: { red: "threads", nombre: "Threads", canal: "redes" },
+  MT: { red: "meta", nombre: "Meta (Facebook o Instagram)", canal: "redes" },
+  WA: { red: "whatsapp", nombre: "Estados de WhatsApp", canal: "redes" },
+  X: { red: "x", nombre: "X", canal: "redes" },
+  LI: { red: "linkedin", nombre: "LinkedIn", canal: "redes" },
+  GO: { red: "google", nombre: "Google", canal: "landing" },
+  BI: { red: "bing", nombre: "Bing", canal: "landing" },
+  WEB: { red: "web", nombre: "la web", canal: "landing" },
+  EM: { red: "email", nombre: "correo", canal: "landing" },
+};
+
+/** «(ref: IG-ART-0112)» en cualquier parte del texto; se toma la última. */
+const REF_RE = /\(\s*ref\s*:\s*([a-z0-9]{1,4})(?:-([a-z0-9]{1,12}))?(?:-([a-z0-9]{1,12}))?\s*\)/gi;
+
+export function leerReferencia(texto: string | null | undefined): OrigenRedes | null {
+  if (!texto || typeof texto !== "string") return null;
+  let ultima: RegExpExecArray | null = null;
+  for (const m of texto.slice(0, 5000).matchAll(REF_RE)) ultima = m as RegExpExecArray;
+  if (!ultima) return null;
+  const codigo = ultima[1].toUpperCase();
+  const campana = ultima[2] ? ultima[2].toUpperCase() : null;
+  const pieza = ultima[3] ? ultima[3].toUpperCase() : null;
+  const conocida = REDES_POR_CODIGO[codigo];
+  return {
+    canal: conocida?.canal ?? "redes",
+    red: conocida?.red ?? codigo.toLowerCase(),
+    campana: campana === "X" ? null : campana,
+    pieza,
+    ref: [codigo, campana, pieza].filter(Boolean).join("-"),
+    palabraClave: null,
+    evidencia: "referencia",
+  };
+}
+
+/** Normaliza un código: sin tildes, solo letras y números, en mayúscula. */
+export function normalizarCodigo(v: unknown, max: number): string {
+  if (typeof v !== "string") return "";
+  return v
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .toUpperCase()
+    .replace(/[^A-Z0-9]/g, "")
+    .slice(0, max);
+}
+
+/** Arma la referencia (el inverso de `leerReferencia`). Devuelve null sin red. */
+export function armarReferencia(input: { red: string; campana?: string | null; pieza?: string | null }): string | null {
+  const red = normalizarCodigo(input.red, 4);
+  if (!red) return null;
+  const campana = normalizarCodigo(input.campana ?? "", 12);
+  const pieza = normalizarCodigo(input.pieza ?? "", 12);
+  if (pieza) return `${red}-${campana || "X"}-${pieza}`;
+  if (campana) return `${red}-${campana}`;
+  return red;
+}
+
+/**
+ * Palabras clave de las series de redes (`.claude/referencias/redes/series-y-volumen.md`)
+ * más las que ya llegaron (ALTA). Se suman otras por perfil desde
+ * `rubros.source_identifiers` con `{ "texto": "PALABRA", "fuente": "palabra_clave" }`.
+ */
+export const PALABRAS_CLAVE_REDES: Record<string, string[]> = {
+  civil: ["FIRMA", "SEGURO", "TRAYECTO", "ART", "ALTA"],
+  penal: ["FIRMA", "SEGURO", "TRAYECTO", "ART", "ALTA"],
+  coberturas_medicas: ["APORTES", "COMPARAR", "PLAN"],
+  agencia_0km: ["LLAVE", "PLAN", "0KM"],
+  marketing: ["CRM", "BIO", "ORDEN"],
+};
+
+/** Palabras clave del perfil: las de la serie más las configuradas (válidas). */
+export function palabrasClaveDe(area: string | null | undefined, configuradas?: unknown): string[] {
+  const base = (area && PALABRAS_CLAVE_REDES[area]) || [];
+  const extra = Array.isArray(configuradas)
+    ? configuradas
+        .filter((x) => x && typeof x === "object" && (x as any).fuente === "palabra_clave")
+        .map((x) => normalizarCodigo((x as any).texto, 20))
+        .filter((p) => p.length >= 2)
+    : [];
+  return [...new Set([...base, ...extra])];
+}
+
+/** Saludos y muletillas que pueden rodear a la palabra clave. */
+const RELLENO = new Set(
+  "hola holaa buenas buenos buen dia dias tardes noches que tal como estas estan info informacion quiero quisiera me interesa interesado interesada por favor porfa gracias palabra clave mas sobre de del el la los las mi una un te les escribo escribi mando aca envio".split(" ")
+);
+
+/**
+ * Devuelve la palabra clave si el mensaje es solo esa palabra (con saludo o
+ * muletillas alrededor). Tope de 80 caracteres: un mensaje largo es una consulta.
+ */
+export function detectarPalabraClave(texto: string | null | undefined, palabras: string[]): string | null {
+  if (!texto || typeof texto !== "string" || texto.length > 80 || palabras.length === 0) return null;
+  const tokens = texto
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .toLowerCase()
+    .replace(/[^a-z0-9ñ]+/g, " ")
+    .trim()
+    .split(" ")
+    .filter((t) => t && !RELLENO.has(t));
+  if (tokens.length !== 1) return null;
+  const candidata = tokens[0].toUpperCase();
+  return palabras.find((p) => normalizarCodigo(p, 20) === candidata) ?? null;
+}
+
+/** Nombre legible de la red para el detalle de la fuente. */
+export function nombreRed(red: string | null): string | null {
+  if (!red) return null;
+  const hit = Object.values(REDES_POR_CODIGO).find((r) => r.red === red);
+  return hit?.nombre ?? red;
+}
+
+/** Detalle de una línea para `first_source_detail` (sin datos personales). */
+export function detalleOrigen(o: OrigenRedes): string {
+  return [
+    o.canal,
+    nombreRed(o.red),
+    o.campana ? `campaña ${o.campana}` : null,
+    o.pieza ? `pieza ${o.pieza}` : null,
+    o.palabraClave ? `palabra clave ${o.palabraClave}` : null,
+    o.ref ? `ref ${o.ref}` : null,
+  ]
+    .filter(Boolean)
+    .join(" · ");
+}
