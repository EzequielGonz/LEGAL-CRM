+
+test("detectarFuente: palabra clave por WhatsApp y por mensaje directo de Instagram", () => {
+  const wa = detectarFuente({ channelType: "whatsapp", body: "FIRMA", palabrasClave: palabrasClaveDe("civil") });
+  assert.equal(wa.fuente, "no_informada");
+  assert.equal(wa.detalle, "redes · palabra clave FIRMA");
+  const ig = detectarFuente({ channelType: "instagram", body: "Hola FIRMA", palabrasClave: palabrasClaveDe("civil") });
+  assert.equal(ig.fuente, "instagram");
+  assert.equal(ig.origen?.red, "instagram");
+});
+
+test("detectarFuente: un contacto de base que responde una palabra no se acredita a redes", () => {
+  const f = detectarFuente({ channelType: "whatsapp", body: "PLAN", palabrasClave: palabrasClaveDe("agencia_0km"), contactSource: "base_de_datos" });
+  assert.deepEqual(f, { fuente: "base_importada", detalle: null });
+});
+
+test("detectarFuente: el anuncio de Meta sigue teniendo prioridad sobre la referencia", () => {
