+  assert.equal(f.origen?.red, "tiktok");
+  assert.match(f.detalle ?? "", /^redes · TikTok/);
+});
+
+test("detectarFuente: visita orgánica a la landing", () => {
+  const f = detectarFuente({ channelType: "whatsapp", body: "Hola, vi «Plan de ahorro» en su web. (ref: GO)" });
+  assert.equal(f.fuente, "landing");
+  assert.equal(f.origen?.canal, "landing");
