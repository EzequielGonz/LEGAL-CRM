+  assert.equal(detalleFormulario(lead), "formulario /accidentes-laborales · desde redes · llegó desde Instagram · campaña ART · pieza 0112 · ref IG-ART-0112");
+  assert.equal(origenDelFormulario({ ref: "(ref: FB-PERFIL)" })?.red, "facebook");
