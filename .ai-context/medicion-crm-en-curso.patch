+
+test("formulario: referencia y etiquetas saneadas, sin guardar el fbclid", () => {
+  const body = {
+    nombre: "Persona",
+    apellido: "Ficticia",
+    telefono: "1100000000",
+    tipo: "Accidente laboral",
+    descripcion: "Texto de prueba",
+    origen: "/accidentes-laborales",
+    llegada: "instagram",
+    atribucion: { ref: "IG-ART-0112", utm_source: "instagram", utm_medium: "historia", utm_campaign: "art<script>", utm_content: "0112", fbclid: "IwAR-ficticio" },
