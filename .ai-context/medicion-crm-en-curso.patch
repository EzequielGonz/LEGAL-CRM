+
+test("detalle del origen sin datos de más", () => {
+  assert.equal(detalleOrigen({ canal: "landing", red: "web", campana: null, pieza: null, ref: "WEB", palabraClave: null, evidencia: "referencia" }), "landing · la web · ref WEB");
+});
